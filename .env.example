# Operator OS - environment template
# Copy this file to .env and fill in ONLY the keys for the job you are doing.
# Never commit .env. Never paste a real key into chat.

# ============================================================
# META ADS  (skills: meta-ads, ads-report, ad-pipeline, market-research)
# ============================================================
# Long-lived user or system token with ads_read. Get it at:
# https://developers.facebook.com/tools/explorer
META_ACCESS_TOKEN=
# Your ad account, format act_XXXXXXXXXX
META_AD_ACCOUNT_ID=

# ============================================================
# VIDEO  (skill: video-studio)
# ============================================================
# Absolute path to the edit kit you installed (see video-studio SKILL.md)
VIDEO_KIT_PATH=
# ElevenLabs API key for transcription (used by the edit kit)
ELEVENLABS_API_KEY=

# ============================================================
# LANDING PAGE / FUNNEL  (skill: landing-page)
# Everything below is per-brand. Rename the BRAND_ prefix per brand if you run several.
# ============================================================
# Supabase project (stores leads + CRM). Create one free at supabase.com
BRAND_SUPABASE_URL=
BRAND_SUPABASE_SECRET_KEY=
# Resend (sends emails). Needs a VERIFIED sending domain. resend.com
RESEND_API_KEY=
BRAND_EMAIL_FROM=Your Brand <hello@yourbrand.com>
BRAND_EMAIL_REPLY_TO=you@yourbrand.com
# Telegram alert on each new lead. Make a bot with @BotFather, get your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Meta Pixel + Conversions API for ad tracking
META_PIXEL_ID=
META_CAPI_TOKEN=
# Public URLs
BRAND_SITE_URL=https://yourbrand.com
BRAND_MESSENGER_URL=https://m.me/YourPageHandle
# CRM dashboard login (you choose these)
BRAND_CRM_USERNAME=
BRAND_CRM_PASSWORD=
# Email nurture engine. LEAVE BLANK until you are ready to send live.
BRAND_SEQUENCE_ENABLED=
BRAND_SEQUENCE_FROM=Your Brand <hello@yourbrand.com>
BRAND_SEQUENCE_DAILY_CAP=80
# Protects the daily cron endpoint (any random string)
CRON_SECRET=

# ============================================================
# DEPLOY (optional)
# ============================================================
# Your Vercel team/scope slug, if you deploy via CLI
VERCEL_SCOPE=
